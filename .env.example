# Copy these names into Netlify → Site configuration → Environment variables.
# Never put real keys in this file or in public/ — the phone app must not contain them.

# Google Cloud key with "Routes API" and "Places API (New)" enabled
GOOGLE_MAPS_API_KEY=

# DVLA Vehicle Enquiry Service key (from the DVLA developer portal)
DVLA_API_KEY=

# Anthropic API key (console.anthropic.com) for the AI stories and fun facts
ANTHROPIC_API_KEY=

# Optional: which Claude model writes the stories (default claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# Optional but recommended: a passcode the app must send, so strangers can't use your keys
APP_PASSCODE=
